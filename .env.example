# PostgreSQL thật. Bỏ trống → dùng PGlite (PostgreSQL nhúng, lưu ở apps/api/.data/pg) cho dev.
DATABASE_URL=
# Bắt buộc đổi khi deploy.
JWT_SECRET=doi-chuoi-bi-mat-nay
# true: OTP cố định 123456 hiển thị trên màn đăng nhập, có nút "Xem với vai trò" và nạp lại dữ liệu demo.
# false: tắt toàn bộ lối tắt demo (bắt buộc khi go-live).
DEMO_MODE=true
PORT=3000
# Giới hạn origin gọi API (phân tách bằng dấu phẩy). Bỏ trống = cho phép tất cả.
CORS_ORIGIN=
# Thư mục lưu file upload (giấy tờ, bằng chứng, tài liệu). Mặc định apps/api/.data/uploads.
UPLOAD_DIR=
# Job định kỳ trong API (hết hạn điểm, xét hạng ngày 01, khoá sổ ngày 05, ngủ đông, hẹn giờ thông báo, đồng bộ KiotViet).
# Chạy nhiều bản API thì chỉ bật ở một bản.
CRON_ENABLED=true

# ---- Tích hợp (bỏ trống = chế độ giả lập) ----
# KiotViet Public API — mã khách hàng KiotViet phải trùng mã đại lý (DLxxxxx).
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=
# Zalo OA / ZNS — mã template đã được Zalo duyệt, dạng JSON: {"otp":"123456","points":"234567","order_approved":"...","tier_up":"...","redeem":"...","expiring":"..."}
ZALO_OA_ACCESS_TOKEN=
ZNS_TEMPLATES=
# Zalo CRM tự xây của khách: webhook nhận sự kiện (ký HMAC-SHA256 ở header X-DMP-Signature).
ZALO_CRM_WEBHOOK_URL=
ZALO_CRM_SECRET=
